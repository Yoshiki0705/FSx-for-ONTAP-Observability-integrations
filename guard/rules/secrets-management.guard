# CloudFormation Guard rules for secrets management
# Ensures no plaintext credentials in templates.
#
# Advisory rules: violations are reported but do not fail CI. See
# guard/rules/critical-security.guard for the blocking rule set.
#
# Custom message placement: a `<<message>>` binds to the clause immediately
# above it and cannot follow a `{ ... }` block. A misplaced message makes the
# file unparseable while `cfn-guard validate` still exits 0, so the rules stop
# running silently. CI greps stderr for "Parsing error" to catch that.

let secrets = Resources.*[ Type == "AWS::SecretsManager::Secret" ]

rule secrets_have_description when %secrets !empty {
  %secrets.Properties.Description exists
  <<Secrets Manager secrets should have a Description for documentation>>
}

# No hardcoded secret values in templates.
#
# The rule targets literals committed to the repository, so it only inspects
# SecretString values that are plain strings. These all pass:
#
#   SecretString: !Ref ApiKey                       # supplied at deploy time
#   SecretString: '{{resolve:ssm-secure:/path}}'    # dynamic reference
#   (SecretString omitted)                          # populated out of band
#
# and this fails:
#
#   SecretString: 'actual-secret-value'
#
# Filtering on `is_string` is what keeps intrinsic functions from tripping the
# rule: `!Ref` and `!Sub` parse to structs, not strings. The gap that leaves is
# a !Sub with the secret inlined in its template string -- that is a struct and
# passes. gitleaks covers that case from the other direction.
rule no_hardcoded_secrets when %secrets !empty {
  %secrets[ Properties.SecretString is_string ].Properties.SecretString == /^\{\{resolve:.*\}\}$/
  <<A literal SecretString is a secret committed to the repository. Omit SecretString and populate the secret out of band, pass it in with !Ref to a NoEcho parameter, or use a {{resolve:...}} dynamic reference.>>
}
