# Copy to terraform.tfvars (gitignored) and replace the placeholders.
region         = "ap-northeast-1"
log_group_name = "/syslog/fsxn-admin-audit"

# Optional. Values shown are examples; omitted lines use the module defaults.
# name_prefix        = "fsxn-log-alarm"
# notification_email = "ops@example.com"
